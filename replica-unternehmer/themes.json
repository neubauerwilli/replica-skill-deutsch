    {"id": "integrations", "label": "Anbindungen, Import und Export", "kind": "request",
     "patterns": ["\\bintegrat", "\\bzapier\\b", "\\bgoogle (calendar|sheets|drive)\\b", "\\boutlook\\b", "\\bslack\\b", "\\bapi\\b", "\\bexport\\b", "\\bimport\\b", "\\bcsv\\b", "\\bwebhook",
                 "\\banbindung", "\\bschnittstelle"]},
    {"id": "platforms", "label": "Plattformen, Offline und Mobil", "kind": "request",
     "patterns": ["\\boffline\\b", "\\bandroid\\b", "\\bipad\\b", "\\btablet\\b", "\\bdesktop app\\b", "\\bmac app\\b", "\\bwindows\\b", "\\bmobile (app|version)\\b", "\\bweb version\\b",
                 "\\bhandy-?app\\b", "\\bdesktop-?app\\b", "\\bweb-?version\\b"]},
    {"id": "customisation", "label": "Anpassung und Kontrolle", "kind": "request",
     "patterns": ["\\bcustomi[sz]", "\\bdark mode\\b", "\\btheme\\b", "\\bbranding\\b", "\\bwhite.?label\\b", "\\btemplates?\\b", "\\bsettings?\\b", "\\boption to\\b",
                 "\\banpass", "\\bdunkelmodus\\b", "\\bvorlage", "\\beinstellung"]},
    {"id": "collaboration", "label": "Teams und Teilen", "kind": "request",
     "patterns": ["\\bteam(s|mates?)?\\b", "\\bshar(e|ing)\\b", "\\bcollaborat", "\\bmultiple (users|accounts|people)\\b", "\\broles?\\b", "\\bpermissions for\\b",
                 "\\bteilen\\b", "\\bzusammenarbeit", "\\bmehrere (nutzer|konten|personen)\\b", "\\brollen\\b"]}
  ]
}
