                 "\\bverwirrend\\b", "\\bumständlich\\b", "\\bkompliziert\\b", "\\bunübersichtlich\\b", "\\bnicht intuitiv\\b", "\\bzu viele (schritte|klicks)\\b", "\\bschwer zu (finden|bedienen|verstehen)\\b", "\\bfinde (ich )?nicht\\b"]},
    {"id": "support", "label": "Support, der nicht antwortet", "kind": "complaint",
     "patterns": ["\\bcustomer (service|support)\\b", "\\bsupport (team|is|was)\\b", "\\bno (response|reply)\\b", "\\bnever (replied|responded|heard back)\\b", "\\bticket\\b", "\\bchat ?bot\\b",
                 "\\bkundenservice\\b", "\\bkundensupport\\b", "\\bkundendienst\\b", "\\bsupport (antwortet|reagiert)\\b", "\\bkeine antwort\\b", "\\bnie (geantwortet|gemeldet)\\b"]},
    {"id": "account", "label": "Probleme mit Anmeldung und Konto", "kind": "complaint",
     "patterns": ["\\blog ?in\\b", "\\bsign ?in\\b", "\\bpassword\\b", "\\blocked out\\b", "\\bverification\\b", "\\b2fa\\b", "\\bdelete (my )?account\\b",
