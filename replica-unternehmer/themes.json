    {"id": "privacy", "label": "Datenschutz und Berechtigungen", "kind": "complaint",
     "patterns": ["\\bprivacy\\b", "\\btracking\\b", "\\bsell(s|ing)? (my )?data\\b", "\\bpermissions?\\b", "\\bcreepy\\b",
