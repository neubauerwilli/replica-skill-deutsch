{
  "_about": "Themen, in die reviews.py das Feedback sortiert. Die Muster sind reguläre Ausdrücke in Python und werden ohne Beachtung der Groß- und Kleinschreibung gegen den Bewertungstext geprüft. Die englischen Muster stehen zuerst, weil viele Store-Bewertungen auf Englisch sind, dahinter die deutschen. kind ist complaint (etwas, das Nutzer hassen) oder request (etwas, das Nutzer wollen und das fehlt). Ändere frei: füge die eigenen Wörter der App-Kategorie hinzu (bei einer Buchungs-App: Doppelbuchung, Zeitzone, nicht erschienen).",
  "request_patterns": [
    "\\bi wish\\b",
    "\\bplease add\\b",
    "\\bwould be (nice|great|good|helpful)\\b",
    "\\bwould love\\b",
    "\\bneeds? (a|an|the|to|more)\\b",
    "\\bno way to\\b",
    "\\bthere'?s no (way|option)\\b",
    "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|import|customi[sz]e|connect|undo|delete|turn off)\\b",
    "\\b(missing|lacks|lacking)\\b",
    "\\bdoesn'?t (have|support|let|allow)\\b",
    "\\bif only\\b",
    "\\bfeature request\\b",
    "\\bwhy (can'?t|isn'?t|doesn'?t)\\b",
    "\\bich wünsche mir\\b",
    "\\bbitte (hinzufügen|ergänzen|einbauen)\\b",
    "\\bwäre (schön|toll|gut|hilfreich)\\b",
    "\\bwürde mich freuen\\b",
    "\\bes fehlt\\b",
    "\\bfehlt\\b",
    "\\bkeine möglichkeit\\b",
    "\\bleider (kein|keine|nicht)\\b",
    "\\bwarum (kann|geht|gibt es) (man )?(nicht|kein|keine)\\b"
  ],
  "themes": [
    {"id": "pricing", "label": "Preis und Bezahlschranken", "kind": "complaint",
     "patterns": ["\\bexpensive\\b", "\\boverpriced\\b", "\\bpric(e|es|ey|ing)\\b", "\\bpaywall", "\\bsubscription\\b", "\\bper (month|seat|user)\\b", "\\bfree (plan|tier|version)\\b", "\\bupgrade to\\b", "\\bpremium\\b", "\\bnot worth\\b", "\\bcost(s|ly)?\\b",
                 "\\bteuer\\b", "\\bpreis(e|erhöhung)?\\b", "\\babo\\b", "\\bpro (monat|nutzer|platz)\\b", "\\bbezahlschranke\\b", "\\bkostenlos(e|en)? (version|tarif)\\b", "\\bnicht (es )?wert\\b", "\\bkosten\\b", "\\bgebühr"]},
    {"id": "billing", "label": "Abrechnung, Kündigung und Erstattung", "kind": "complaint",
     "patterns": ["\\bcharged\\b", "\\brefund", "\\bcancel(l?ing|l?ed|lation)?\\b", "\\bauto.?renew", "\\bhidden (fee|charge)", "\\bbilling\\b", "\\bscam\\b", "\\bcredit card\\b",
                 "\\babgebucht\\b", "\\berstattung", "\\bgeld zurück\\b", "\\bkündig", "\\bautomatisch verlängert\\b", "\\bversteckte (kosten|gebühren)", "\\babrechnung\\b", "\\bbetrug\\b", "\\babzocke\\b", "\\bkreditkarte\\b"]},
    {"id": "bugs", "label": "Fehler und Abstürze", "kind": "complaint",
     "patterns": ["\\bcrash(es|ed|ing)?\\b", "\\bbugs?\\b", "\\bbuggy\\b", "\\bglitch", "\\bfreez(e|es|ing)\\b", "\\bbroken\\b", "\\b(doesn'?t|does not|stopped) work", "\\bnot working\\b", "\\berror\\b",
                 "\\babsturz", "\\babgestürzt\\b", "\\bstürzt\\b", "\\bfehler\\b", "\\bhängt sich auf\\b", "\\bfriert\\b", "\\bkaputt\\b", "\\bfunktioniert nicht\\b", "\\bgeht nicht\\b"]},
    {"id": "performance", "label": "Langsam, ruckelig, schwerfällig", "kind": "complaint",
     "patterns": ["\\bslow\\b", "\\blag(gy|s)?\\b", "\\bloading\\b", "\\btakes forever\\b", "\\bbattery\\b", "\\bsluggish\\b", "\\bheavy\\b",
                 "\\blangsam\\b", "\\bruckel", "\\blädt (ewig|lange)\\b", "\\bakku\\b", "\\bträge\\b"]},
    {"id": "data", "label": "Synchronisierung und verlorene Daten", "kind": "complaint",
